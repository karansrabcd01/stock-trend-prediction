# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
env/
ENV/
.venv

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment files
.env
.env.local
.env.*.local

# Git
.git/
.gitignore
.gitattributes

# Documentation (not needed in container)
*.md
!README.md
docs/
PRESENTATION_SLIDES.md
PROJECT_REPORT.md
EXECUTIVE_SUMMARY.md
REPORT_INDEX.md
SCREENSHOTS_DEMO_GUIDE.md

# Notebooks
notebooks/
*.ipynb
.ipynb_checkpoints

# Testing
.pytest_cache/
.coverage
htmlcov/
tests/
test_*.py
*_test.py

# Build artifacts
dist/
build/
*.egg-info/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Deployment configs (not needed in container)
.vercel
.netlify
.railway
.render
render.yaml
vercel.json
netlify.toml
railway.json

# Docker files (avoid recursion)
Dockerfile*
docker-compose*.yml
.dockerignore

# Assets (if not needed for runtime)
assets/
screenshots/
